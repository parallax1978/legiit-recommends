# Legiit Recommends — environment variables.
#
# Local development: run `npm run env:local` after `npm run db:start`; it writes .env.local
# (web) and .env.operator (scripts) from the local Supabase stack.
# Hosted: set the "Web app" block in Vercel. Put the "Operator scripts" block in a git-ignored
# file on the machine (or CI job) that runs deployments — Next.js does not read it. Keep it
# apart from the local stack's .env.operator and select it per command:
#   ENV_FILE=.env.operator.production npm run deploy:supabase

# --- Web app (Vercel project environment variables) ------------------------------------------
# These two are safe to expose to browsers. The web app holds no service key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Only needed when Edge Functions are served from a different origin than the API.
# SUPABASE_FUNCTIONS_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1

# --- Operator scripts (never set these in Vercel) --------------------------------------------
# Used by: npm run deploy:supabase, auth:configure, db:push:api, bootstrap:owner,
# queues:activate.
SUPABASE_PROJECT_REF=YOUR-PROJECT-REF
# Supabase dashboard → Account → Access Tokens. Everything the scripts do goes over HTTPS with
# this token; they read the project's secret key with it when they need one.
SUPABASE_ACCESS_TOKEN=
# Public https URL of the deployed web app. Email links and auth redirects point here, so use
# the address people can open (not a preview alias behind a login).
SITE_URL=https://recommends.example.com

# --- Optional --------------------------------------------------------------------------------
# Apply migrations with `supabase db push` over a direct database connection instead of the
# Management API.
# SUPABASE_DB_PASSWORD=
# Shared secret between Supabase Cron and the queue consumer. Leave unset to have each deploy
# generate and install a new one.
# WORKER_SECRET=
# Only needed without an access token (for example for the local stack, where env:local sets
# them).
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
# Password for the owner account when bootstrapping without email (local development, tests).
# OWNER_PASSWORD=
# Live smoke test only (npm run smoke:live). Real requests are billed to this key.
# OPENAI_API_KEY=
# LIVE_SMOKE_MODEL=
# LIVE_SMOKE_MAX_USD=
