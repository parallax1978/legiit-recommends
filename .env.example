# Legiit Recommends — environment variables.
#
# Local development: run `npm run env:local` after `npm run db:start`; it writes .env.local
# (web) and .env.operator (scripts) from the local Supabase stack.
# Hosted: set the "Web app" block in Vercel. Put the "Operator scripts" block in a file named
# .env.operator on the machine (or CI job) that runs deployments — Next.js does not read it.

# --- Web app (Vercel project environment variables) ------------------------------------------
# These two are safe to expose to browsers. The web app holds no service key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Only needed when Edge Functions are served from a different origin than the API.
# SUPABASE_FUNCTIONS_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1

# --- Operator scripts (never set these in Vercel) --------------------------------------------
# Used by: npm run bootstrap:owner, queues:activate, deploy:supabase, smoke:live.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_PROJECT_REF=YOUR-PROJECT-REF
SUPABASE_DB_PASSWORD=
# Public URL of the deployed web app. Used for invitation links and auth redirects.
SITE_URL=https://recommends.example.com
# Shared secret between Supabase Cron and the queue consumer. Generate: openssl rand -hex 32
WORKER_SECRET=

# --- Optional -------------------------------------------------------------------------------
# Password for the owner account when bootstrapping without email delivery (local development).
# OWNER_PASSWORD=
# Live smoke test only (npm run smoke:live). Real requests are billed to this key.
# OPENAI_API_KEY=
# LIVE_SMOKE_MODEL=
# LIVE_SMOKE_MAX_USD=
