{
  "name": "legiit-recommends",
  "version": "1.0.0",
  "private": true,
  "description": "Legiit Recommends \u2014 repeatable OpenAI conversation campaigns with independent fresh-check measurement.",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "typecheck:functions": "deno check --config supabase/functions/deno.json supabase/functions/worker/index.ts supabase/functions/ops/index.ts",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test --trace off",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "supabase": "supabase",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --level warning --fail-on warning -s public,app_private",
    "db:types": "supabase gen types --lang typescript --schema public > src/lib/supabase/database.types.ts && prettier --write src/lib/supabase/database.types.ts",
    "env:local": "bash scripts/local-env.sh",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env",
    "bootstrap:owner": "tsx scripts/bootstrap-owner.ts",
    "queues:activate": "tsx scripts/activate-queues.ts",
    "db:push:api": "tsx scripts/apply-migrations.ts",
    "auth:configure": "tsx scripts/configure-auth.ts",
    "fake-openai": "tsx tests/support/fake-openai-server.ts",
    "smoke:live": "tsx scripts/live-smoke.ts",
    "deploy:supabase": "bash scripts/deploy-supabase.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "clsx": "2.1.1",
    "lucide-react": "1.71.0",
    "next": "16.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "openai": "7.53.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "3.1.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
