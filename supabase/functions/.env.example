# Secrets for the Edge Functions when running locally (copy to supabase/functions/.env).
# In a hosted project set them with `supabase secrets set` (see scripts/deploy-supabase.sh).

# Shared secret Supabase Cron presents when it wakes the queue consumer. Must match the value
# stored in Vault by `npm run queues:activate`.
WORKER_SECRET=local-dev-worker-secret-change-me-0000

# Public URL of the web app (used in invitation emails).
SITE_URL=http://localhost:3000

# Leave unset to use the real OpenAI API. The test suites point this at the local provider
# double (tests/support/fake-openai.ts), which never contacts OpenAI.
# OPENAI_BASE_URL=http://host.docker.internal:4010/v1
